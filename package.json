{
  "name": "@looms/bloom-design",
  "version": "1.0.0",
  "description": "Bloom Design tokens, theming and composable React controls, dialogs, portraits and node graphs.",
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "source": "./src/index.ts",
      "default": "./dist/index.js"
    },
    "./tokens": {
      "types": "./src/tokens.ts",
      "source": "./src/tokens.ts",
      "default": "./dist/tokens.js"
    },
    "./layout": {
      "types": "./src/layout.ts",
      "source": "./src/layout.ts",
      "default": "./dist/layout.js"
    },
    "./color": {
      "types": "./src/color.ts",
      "source": "./src/color.ts",
      "default": "./dist/color.js"
    },
    "./theme": {
      "types": "./src/theme.ts",
      "source": "./src/theme.ts",
      "default": "./dist/theme.js"
    },
    "./pathNode": {
      "types": "./src/pathNode.ts",
      "source": "./src/pathNode.ts",
      "default": "./dist/pathNode.js"
    },
    "./skins": {
      "types": "./src/skins.ts",
      "source": "./src/skins.ts",
      "default": "./dist/skins.js"
    },
    "./react": {
      "types": "./src/react/index.ts",
      "source": "./src/react/index.ts",
      "default": "./dist/react/index.js"
    },
    "./react/styles.css": {
      "source": "./src/react/styles.css",
      "default": "./dist/react/styles.css"
    },
    "./modal-room": {
      "types": "./src/react/modalRoom.ts",
      "source": "./src/react/modalRoom.ts",
      "default": "./dist/react/modalRoom.js"
    },
    "./synth/*": "./src/synth/*",
    "./preview3d": {
      "types": "./src/react/preview3d/index.ts",
      "source": "./src/react/preview3d/index.ts",
      "default": "./dist/preview3d.js"
    },
    "./preview3d/model": {
      "types": "./src/react/preview3d/model.ts",
      "source": "./src/react/preview3d/model.ts",
      "default": "./dist/preview3d/model.js"
    },
    "./preview3d/react": {
      "types": "./src/react/preview3d/react.ts",
      "source": "./src/react/preview3d/react.ts",
      "default": "./dist/preview3d/react.js"
    },
    "./preview3d/styles.css": {
      "source": "./src/react/preview3d/styles.css",
      "default": "./dist/preview3d/styles.css"
    },
    "./skinAssignments": {
      "types": "./src/skinAssignments.ts",
      "source": "./src/skinAssignments.ts",
      "default": "./dist/skinAssignments.js"
    },
    "./skinKinds": {
      "types": "./src/skinKinds.ts",
      "source": "./src/skinKinds.ts",
      "default": "./dist/skinKinds.js"
    },
    "./skinForms": {
      "types": "./src/skinForms.ts",
      "source": "./src/skinForms.ts",
      "default": "./dist/skinForms.js"
    },
    "./skinContainer": {
      "types": "./src/skinContainer.ts",
      "source": "./src/skinContainer.ts",
      "default": "./dist/skinContainer.js"
    }
  },
  "sideEffects": [
    "**/*.css"
  ],
  "peerDependencies": {
    "react": ">=18",
    "three": "0.180.0",
    "react-dom": ">=18"
  },
  "license": "UNLICENSED",
  "files": [
    "dist",
    "src",
    "unity",
    "scripts/build.mjs",
    "README.md",
    "examples"
  ],
  "scripts": {
    "build": "node scripts/build.mjs",
    "prepare": "npm run build",
    "check": "tsc -p . && node scripts/size-gate.mjs",
    "test": "node --test tests/*.test.ts",
    "check:graph": "tsc -p tsconfig.graph-tests.json",
    "check:forms": "tsc -p tsconfig.form-tests.json && node --test tests/photos.test.ts tests/pipRowForm.test.ts tests/loading.test.ts",
    "check:sky": "tsc -p tsconfig.sky-tests.json"
  },
  "devDependencies": {
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "esbuild": "0.28.2",
    "three": "0.180.0",
    "typescript": "^7.0.2",
    "@types/node": "25.9.9",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "dependencies": {
    "lucide-react": "^0.487.0",
    "@types/three": "0.180.0"
  },
  "peerDependenciesMeta": {
    "three": {
      "optional": true
    }
  }
}
